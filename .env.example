# Copy to backend/.env and fill in. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://bep:bep@localhost:5432/bep
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=generate-with-openssl-rand-hex-32
CREDENTIALS_ENCRYPTION_KEY=generate-with-python-cryptography-Fernet.generate_key
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_TRACKING_BASE_URL=http://localhost:8000

# Amazon SES (Phase 8)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Object storage (SeaweedFS S3 locally)
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=bep-assets

# AI assistant (Phase 6, optional)
LLM_API_KEY=
