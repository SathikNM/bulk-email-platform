# Copy to backend/.env (local Python) or set as environment variables (Docker/production).
# Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://bep:bep@localhost:5432/bep
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=generate-with-openssl-rand-hex-32
CREDENTIALS_ENCRYPTION_KEY=          # Fernet key; REQUIRED in production
COOKIE_SECURE=false                   # true in production (HTTPS)
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_BASE_URL=http://localhost:8000 # tracking/unsubscribe links; https:// in production
APP_BASE_URL=http://localhost:3000

# Storage: local (shared volume) or s3 (AWS S3 / SeaweedFS)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
S3_ENDPOINT_URL=
S3_BUCKET=bep-assets
S3_PUBLIC_BASE_URL=

# Amazon SES (credentials can also be stored per Sending Account in the app)
AWS_REGION=me-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_WEBHOOK_VERIFY_SIGNATURE=true

# Sending engine
SEND_BATCH_SIZE=50
SEND_MAX_ATTEMPTS=5
CELERY_TASK_ALWAYS_EAGER=false

# AI assistant (Anthropic API). Leave empty to disable.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Seed (first run)
SEED_ADMIN_EMAIL=admin@primecfo.local
SEED_ADMIN_PASSWORD=
